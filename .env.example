# Copy to `.env` for local development. Never commit real values.

# Postgres (see ./start-database.sh). Production uses DATABASE_PASSWORD_FILE.
DATABASE_URL="postgresql://postgres:password@localhost:5432/big-day-planner"

# getAddress.io (optional; the postcode lookup is off unless both are set)
GETADDRESS_API_KEY=
GETADDRESS_URL=

# Resend
RESEND_API_KEY=
# Sender must be on a domain verified in Resend
EMAIL_FROM_ADDRESS=
# Receives song-request notifications
SONG_REQUEST_EMAIL=

# UploadThing
UPLOADTHING_TOKEN=

# Better Auth (required)
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, stable across releases
BETTER_AUTH_SECRET=
BREVO_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_DAILY_LIMIT=40
# Comma-separated emails that may sign in
AUTH_ALLOWED_EMAILS=

# Copy to `.env` for local development. Never commit real values.

# Postgres (see ./start-database.sh). Production uses DATABASE_PASSWORD_FILE.
DATABASE_URL="postgresql://postgres:password@localhost:5432/big-day-planner"

# Clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# getAddress.io (optional; the postcode lookup is off unless both are set)
GETADDRESS_API_KEY=
GETADDRESS_URL=

# Resend
RESEND_API_KEY=
# Sender must be on a domain verified in Resend
EMAIL_FROM_ADDRESS=
# Receives song-request notifications
SONG_REQUEST_EMAIL=

# UploadThing
UPLOADTHING_TOKEN=
